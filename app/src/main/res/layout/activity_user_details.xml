<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darkBlueBackGround"
    android:orientation="vertical"
    >

    <LinearLayout
        android:background="@drawable/dark_gradient"
        android:padding="20dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/backToSignInPageButton"
            android:layout_width="32dp"
            android:layout_height="29dp"
            android:background="@drawable/gradient_card_border"
            android:src="@android:drawable/ic_menu_revert" />

        <TextView
            android:gravity="center"
            android:drawablePadding="5dp"
            android:drawableLeft="@drawable/idcard"
            android:layout_gravity="center"
            android:textColor="#36FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="Your Personal Informations" />

        <EditText
            android:id="@+id/nameEditText"
            android:layout_margin="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            android:hint="Name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_height="wrap_content"
            android:textColor="#36FFFFFF"
            android:text="Enter your name" />

        <EditText
            android:id="@+id/surnameEditText"
            android:layout_margin="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            android:hint="Surname" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_height="wrap_content"
            android:textColor="#36FFFFFF"
            android:text="Enter your Surname" />

        <EditText
            android:id="@+id/ageEditText"
            android:layout_margin="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColorHint="@color/white"
            android:textColor="@color/white"
            android:hint="Age"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginBottom="5dp"
            android:layout_height="wrap_content"
            android:textColor="#36FFFFFF"
            android:text="Enter your age" />

        <EditText
            android:id="@+id/aboutMeEditText"
            android:layout_margin="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColorHint="@color/white"
            android:textColor="@color/white"
            android:hint="About Me"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginBottom="5dp"
            android:layout_height="wrap_content"
            android:textColor="#36FFFFFF"
            android:text="Write something about yourself" />

        <androidx.appcompat.widget.AppCompatButton
            android:background="@drawable/gradient_card_border"
            android:id="@+id/saveButton"
            android:layout_margin="5dp"
            android:layout_width="match_parent"
            android:textColor="@color/white"
            android:layout_height="wrap_content"
            android:text="Save" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="155dp"
        android:background="@drawable/card_border"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="7dp"
                android:drawableRight="@drawable/send"
                android:drawablePadding="5dp"
                android:text="Select Your Avatar"
                android:textColor="@color/white"
                android:textSize="20dp"
                android:textStyle="bold" />


        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="10dp"
            android:text="Before you Next Should Choose an avatar"
            android:textColor="#36FFFFFF"
            android:textSize="10dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/SelectImageButton1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:background="@drawable/button_border"
            android:text="Select"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
